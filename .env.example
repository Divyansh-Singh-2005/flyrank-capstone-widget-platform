# --- App ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
WIDGET_BUNDLE_VERSION=1

# --- Database (Docker Postgres mapped to host port 5433) ---
POSTGRES_USER=widget
POSTGRES_PASSWORD=change-me
POSTGRES_DB=widget_platform
DATABASE_URL=postgresql+psycopg://widget:change-me@localhost:5433/widget_platform

# --- Auth (owner API) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

# --- Privacy ---
IP_HASH_SALT=replace-with-another-random-string

# --- Rate limiting ---
RATE_LIMIT_PER_IP=10/minute
RATE_LIMIT_PER_WIDGET=60/minute
MAX_BODY_BYTES=16384

# --- Geo enrichment ---
# GEO_PROVIDER_MODE: real (ip-api -> ipapi.co) | mock (deterministic, for fallback proof)
GEO_PROVIDER_MODE=real
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_SECONDS=2
MOCK_GEO_A_DOWN=false
MOCK_GEO_B_DOWN=false
# localhost/Docker IPs are private and cannot be geolocated; override in dev only
GEO_DEV_IP_OVERRIDE=8.8.8.8

# --- Email side effect (background job) ---
# EMAIL_MODE: console | smtp (Mailpit)
EMAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
FORCE_EMAIL_FAILURE=false
JOB_MAX_ATTEMPTS=3